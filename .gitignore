node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# skill-eval iteration workspaces (skill-creator scaffolding, not shipped)
.claude/skills/*-workspace/

# brainstorm-agent decision briefs (local handoff artifacts, not shipped)
docs/briefs/

# pnpm v12 auto-writes a trivial lockfile (no deps) at the scripts-only root
# on every `pnpm verify:l06` run — the root is not a package; ignore it.
/pnpm-lock.yaml
