+++ b/server/src/modules/notifications/service.ts
@@ -0,0 +1,33 @@
+import type { Container } from '../../platform/container.js';
+import { TiktokenTokenizer } from '../../adapters/tokenizer/index.js';
+import { NotificationRepository, type NotificationRow } from './repository.js';
+import { renderBody, truncateBody, type MessageInput } from './helpers.js';
+import { MAX_BODY_TOKENS, RECENT_LIMIT } from './constants.js';
+
+/**
+ * Notifications service. Turns a finished review into a feed entry: renders
+ * the body, keeps it inside the token budget, and persists it.
+ */
+export class NotificationService {
+  private repo: NotificationRepository;
+  private tokenizer = new TiktokenTokenizer();
+
+  constructor(container: Container) {
+    this.repo = new NotificationRepository(container.db);
+  }
+
+  async notify(workspaceId: string, input: MessageInput): Promise<NotificationRow> {
+    let body = renderBody(input);
+    if (this.tokenizer.count(body) > MAX_BODY_TOKENS) {
+      body = truncateBody(body);
+    }
+    return this.repo.insert({ workspaceId, kind: input.kind, body });
+  }
+
+  async list(workspaceId: string): Promise<NotificationRow[]> {
+    return this.repo.listRecent(workspaceId, RECENT_LIMIT);
+  }
+}
