+import { desc, eq } from 'drizzle-orm';
+import type { Db } from '../../db/client.js';
+import { notifications } from '../../db/schema.js';
+
+/**
+ * Notifications data access. The only file that queries the `notifications`
+ * table; every query is scoped by workspaceId (tenancy guard).
+ */
+export interface NotificationRow {
+  id: string;
+  workspaceId: string;
+  kind: 'review-completed' | 'review-failed';
+  body: string;
+  createdAt: Date;
+}
+
+export interface InsertNotification {
+  workspaceId: string;
+  kind: NotificationRow['kind'];
+  body: string;
+}
+
+export class NotificationRepository {
+  constructor(private db: Db) {}
+
+  async insert(values: InsertNotification): Promise<NotificationRow> {
+    const [row] = await this.db.insert(notifications).values(values).returning();
+    return row!;
+  }
+
+  async listRecent(workspaceId: string, limit: number): Promise<NotificationRow[]> {
+    return this.db
+      .select()
+      .from(notifications)
+      .where(eq(notifications.workspaceId, workspaceId))
+      .orderBy(desc(notifications.createdAt))
+      .limit(limit);
+  }
+}
diff --git a/server/src/modules/notifications/routes.ts b/server/src/modules/notifications/routes.ts
