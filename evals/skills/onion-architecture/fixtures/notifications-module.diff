@@ -0,0 +1,42 @@
+import type { NotificationRow } from './repository.js';
+import type { Notification } from './routes.js';
+
+/** Everything needed to render one feed entry. */
+export interface MessageInput {
+  kind: 'review-completed' | 'review-failed';
+  repoFullName: string;
+  prNumber: number;
+  title: string;
+}
+
+/** Render the single-line body shown in the notifications feed. */
+export function renderBody(input: MessageInput): string {
+  const mark = input.kind === 'review-completed' ? 'done' : 'failed';
+  return `${mark} ${input.repoFullName}#${input.prNumber} ${input.title}`;
+}
+
+/** Trim a body on a word boundary so feed entries stay single-line. */
+export function truncateBody(body: string, maxChars = 160): string {
+  if (body.length <= maxChars) return body;
+  const cut = body.slice(0, maxChars);
+  const lastSpace = cut.lastIndexOf(' ');
+  return `${lastSpace > 0 ? cut.slice(0, lastSpace) : cut}…`;
+}
+
+/** Map a stored row onto the API response shape. */
+export function toNotificationDto(row: NotificationRow): Notification {
+  return {
+    id: row.id,
+    kind: row.kind,
+    body: row.body,
+    createdAt: row.createdAt.toISOString(),
+  };
+}
