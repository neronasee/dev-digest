@@ -0,0 +1,62 @@
+import type { FastifyInstance } from 'fastify';
+import type { ZodTypeProvider } from 'fastify-type-provider-zod';
+import { z } from 'zod';
+import { desc, eq } from 'drizzle-orm';
+import { notifications } from '../../db/schema.js';
+import { getContext } from '../_shared/context.js';
+import { NotificationService } from './service.js';
+import { toNotificationDto } from './helpers.js';
+import { RECENT_LIMIT } from './constants.js';
+
+/** Wire contract for one feed entry (no shared contract exists yet). */
+const Notification = z.object({
+  id: z.string(),
+  kind: z.enum(['review-completed', 'review-failed']),
+  body: z.string(),
+  createdAt: z.string(),
+});
+export type Notification = z.infer<typeof Notification>;
+
+const NotificationInput = z.object({
+  kind: z.enum(['review-completed', 'review-failed']),
+  repoFullName: z.string().min(3),
+  prNumber: z.number().int().positive(),
+  title: z.string().min(1).max(280),
+});
+
+/**
+ * Notifications module. Parses requests, maps status codes, and delegates
+ * the rest to NotificationService.
+ *   POST /notifications  → record a review outcome for the workspace feed
+ *   GET  /notifications  → the most recent feed entries
+ */
+export default async function notificationRoutes(appBase: FastifyInstance) {
+  const app = appBase.withTypeProvider<ZodTypeProvider>();
+  const service = new NotificationService(app.container);
+
+  app.post(
+    '/notifications',
+    { schema: { body: NotificationInput, response: { 201: Notification } } },
+    async (req, reply) => {
+      const { workspaceId } = await getContext(app.container, req);
+      const row = await service.notify(workspaceId, req.body);
+      reply.status(201);
+      return toNotificationDto(row);
+    },
+  );
+
+  app.get(
+    '/notifications',
+    { schema: { response: { 200: z.array(Notification) } } },
+    async (req) => {
+      const { workspaceId } = await getContext(app.container, req);
+      const rows = await app.container.db
+        .select()
+        .from(notifications)
+        .where(eq(notifications.workspaceId, workspaceId))
+        .orderBy(desc(notifications.createdAt))
+        .limit(RECENT_LIMIT);
+      return rows.map(toNotificationDto);
+    },
+  );
+}
diff --git a/server/src/modules/notifications/service.ts b/server/src/modules/notifications/service.ts
